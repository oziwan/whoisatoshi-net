# Environment Configuration for whoisatoshi.net

# Server
NODE_ENV=production
PORT=3001
ALLOWED_ORIGINS=https://whoisatoshi.net,http://localhost:3000

# Database
DATABASE_PATH=./data/poll-results.json

# Security
IP_SALT=your-secret-salt-here-change-this

# Google Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Google AdSense
GOOGLE_ADSENSE_CLIENT_ID=ca-pub-XXXXX
GOOGLE_ADSENSE_SLOT_ID=XXXXX

# Affiliate Programs
BINANCE_REF_ID=XXXXX
GATE_IO_REF_ID=XXXXX
BYBIT_REF_ID=XXXXX
OKX_REF_ID=XXXXX
PEPERSTONE_REF_ID=XXXXX
OCTAFX_REF_ID=XXXXX
EXNESS_REF_ID=XXXXX

# Email (for contact form)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_EMAIL=ads@whoisatoshi.net

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Social Media
TWITTER_HANDLE=@whoisatoshi_net
REDDIT_COMMUNITY=r/cryptocurrency
DISCORD_LINK=https://discord.gg/XXXXX

# Admin Panel
ADMIN_PASSWORD=change-me-to-secure-password

# Monitoring
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
